# EAS Build runs `npm ci` on its servers, which fails on this project without
# this flag: expo-router pulls web-only optional deps (vaul -> @radix-ui,
# @expo/dom-webview) that want react-dom@19.2.8 against our pinned react@19.2.3.
# Locally we pass --legacy-peer-deps by hand; the build server cannot know that,
# so it has to be configured here or every cloud build fails at install.
#
# Trade-off, deliberate: this flag disables automatic peer installation, which
# has silently dropped eight packages in this project so far (react-native-worklets,
# babel-preset-expo, @react-native/jest-preset, test-renderer, expo-asset,
# react-dom, react-native-gesture-handler, and one inert case). Two of those
# would have broken the build. After adding any dependency, verify it actually
# landed in both package-lock.json and node_modules/ — see AGENTS.md.
legacy-peer-deps=true
