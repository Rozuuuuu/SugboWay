{
  "version": 8,
  "name": "SugboWay Offline",
  "sources": {
    "cebu-offline": {
      "type": "vector",
      "url": "pmtiles:///cebu-tiles.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1a1a2e" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "cebu-offline",
      "source-layer": "water",
      "paint": { "fill-color": "#16213e" }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "cebu-offline",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#334155",
        "line-width": 1.5
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "cebu-offline",
      "source-layer": "building",
      "paint": {
        "fill-color": "#1e293b",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "labels",
      "type": "symbol",
      "source": "cebu-offline",
      "source-layer": "place",
      "layout": {
        "text-field": "{name}",
        "text-size": 11
      },
      "paint": {
        "text-color": "#94a3b8",
        "text-halo-color": "#0f172a",
        "text-halo-width": 1
      }
    }
  ]
}
