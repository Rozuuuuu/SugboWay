# sugboway-ai-service — copy to .env (local) or set in Render env vars.

# Same PostGIS + pgvector Postgres as the routing API.
# Neon supports both `CREATE EXTENSION postgis` and `CREATE EXTENSION vector`.
DATABASE_URL=

# Google Gemini API key (mapped to GOOGLE_API_KEY automatically at startup).
GEMINI_API_KEY=

# URL of the Go routing API (used by the agent tools).
ROUTING_API_URL=http://localhost:8080

# Optional: Redis for response caching (falls back to in-memory if unset).
REDIS_URL=

# Optional: weather context.
OPENWEATHER_KEY=
