# sugboway-ai-service — copy to .env (local) or set in Render env vars.

# Same PostGIS + pgvector Postgres as the routing API.
# Neon supports both `CREATE EXTENSION postgis` and `CREATE EXTENSION vector`.
DATABASE_URL=

# Google Gemini API key (mapped to GOOGLE_API_KEY automatically at startup).
GEMINI_API_KEY=

# URL of the Go routing API (used by the agent tools).
ROUTING_API_URL=http://localhost:8080

# Optional: Redis for response caching (falls back to in-memory if unset).
REDIS_URL=

# Optional: weather context.
OPENWEATHER_KEY=

# Deployment environment. Leave unset (or "production") in production: the service
# then refuses to boot without a strong, non-default AUTH_JWT_SECRET. Set to
# "development" for local runs to allow the insecure dev fallback.
APP_ENV=development

# Shared HS256 secret. MUST match AUTH_JWT_SECRET in the routing API.
# Used to verify the JWT and apply the user's per-tier chat quota.
# Required in production (not the dev default) or the service won't start.
AUTH_JWT_SECRET=

# Browser origins allowed by CORS (comma-separated). Defaults to the deployed web
# app + http://localhost:3000. Set to your web origin in production.
ALLOWED_ORIGINS=
