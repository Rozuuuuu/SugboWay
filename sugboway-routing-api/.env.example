# sugboway-routing-api — copy to .env (local) or set in Render env vars.

# PostGIS-enabled Postgres. Neon free tier works and supports PostGIS.
# Neon: copy the connection string from the dashboard (already has sslmode=require).
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Port the API listens on (Render sets this automatically; defaults to 8080).
PORT=8080

# Set to false to skip auto-running migrations on startup (default: on).
RUN_MIGRATIONS=true

# Browser origins allowed by CORS (comma-separated). Defaults to APP_BASE_URL +
# http://localhost:3000. Set this to your deployed web origin in production.
ALLOWED_ORIGINS=

# --- Weather (server-side; key never reaches the browser) ---
# weatherapi.com key. The web app calls GET /api/v1/weather, which proxies this.
# (Replaces the old client-side NEXT_PUBLIC_WEATHER_API_KEY.)
WEATHER_API_KEY=

# Deployment environment. Leave unset (or "production") in production: the app then
# refuses to boot without a strong, non-default AUTH_JWT_SECRET. Set to "development"
# for local runs to allow the insecure dev fallback below.
APP_ENV=development

# --- Authentication ---
# Shared HS256 secret. MUST match AUTH_JWT_SECRET in the AI service.
# Required in production (>=32 chars, not the dev default) or the app won't start.
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=
# Web origin, for the post-verification redirect.
APP_BASE_URL=http://localhost:3000
# This API's public origin, used to build the verification link in emails.
PUBLIC_API_URL=http://localhost:8080
# From address for verification email (used by whichever provider is active).
EMAIL_FROM=SugboWay <no-reply@sugboway.app>

# Email provider — pick ONE. Brevo is preferred on Render (it sends over HTTPS;
# Render blocks outbound SMTP). If BREVO_API_KEY is set it wins; otherwise SMTP
# is used if SMTP_HOST is set.
#
# Brevo (https://www.brevo.com) — create an account, verify a sender, make an API key:
BREVO_API_KEY=
#
# SMTP fallback (e.g. a Gmail app password). Often blocked on Render.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SugboWay <no-reply@sugboway.app>

# --- Google sign-in (optional) ---
# OAuth 2.0 Web client ID from Google Cloud Console. When set, POST /api/v1/auth/google
# is enabled. Must be the SAME client ID the web app uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=
