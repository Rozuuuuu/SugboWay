# sugboway-routing-api — copy to .env (local) or set in Render env vars.

# PostGIS-enabled Postgres. Neon free tier works and supports PostGIS.
# Neon: copy the connection string from the dashboard (already has sslmode=require).
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Port the API listens on (Render sets this automatically; defaults to 8080).
PORT=8080

# Set to false to skip auto-running migrations on startup (default: on).
RUN_MIGRATIONS=true
